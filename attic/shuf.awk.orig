BEGIN   { FS="[ \t]*,[ \t]*"; OFS=","; Seed=1 
empty() { next }
!hdr++  { srand(Seed); print; next }
        { a[++n] = $0 }
END     { N = N ? N : n
          while (N > 0) { 
            shuffle(); for(i=1;i<=n && N-- > 0;i++) print a[i]}}

function shuffle(   i,j,tmp) {
  for(i=n; i>1; i--) { 
    j=int(rand()*i)+1; tmp=a[i]; a[i]=a[j]; a[j]=tmp } }

function empty() {
  sub(/#.*/,"")
  gsub(/^[[:space:]]+|[[:space:]]+$/,"")
  $1=$1
  return $0=="" }
