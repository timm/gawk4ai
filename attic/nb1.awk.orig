# usage: ... | gawk -f xval.awk [N=1000, SEED=1]
# vim: set et sw=2 ts=2 sts=2 cc=75 :
# m,k: low freq mamanement; n,mu,m2,sd,seen: counts; x,y:roles
BEGIN { FS="[ \t]*,[ \t]*"; M=2; K=1; Wait=10; Bins=10 }
NR==1 { head(); next }
      { NR > Wait? print $NF "\t" classify() : train() }

function head(   c) {
  for(c=1;c<=NF;c++) {
    if ($c ~ /X$/) return
    N[c]
    if ($c !~ /[!X]$/) X[c]
    if ($c ~ /^[A-Z]/) Mu[c] = M2[c] = 0 }}

function train(    c,d) {
  Rows++
  H[$NF]++
  for(c=1;c<=NF;c++) {
    if ($c == "?") continue
    N[c]++
    if (c in Mu) { 
      d=$c-Mu[c]; Mu[c]+= d/N[c]; M2[c]+= d*($c-Mu[c]) }
      if(N[c] > 1) Sd[c] =  sqrt(M2[c]/(N[c]-1)) }
    F[$NF][c][discretize(c,$c)]++ } }

function discretize(c,v) {
  return (c in Mu) ? int(Bins * cdf(v, Mu[c], sd(c))) : v }


function cdf(v,mu,s,   z) {
  z = (v - mu)/(s + 1E-32)
  z = z>3 ? 3 : (z<-3 ? -3 : z)
  return 1/(1 + exp(-1.7*z)) }

function classify(   h,v,best,out) {
  for(h in H) { v=like(h); if (!out || v > best) {best=v; out=h}}
  return out }

function like(h,   c,p,out) {
  p = (H[h] + K) / (Rows + K*length(H))
  for(c in X) 
    if ($c!="?") out += log((F[h][c][disc(c,$c)]+M*p) / (H[h]+M))
  return out + log(p) }
